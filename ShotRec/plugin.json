{
    "$schema": "https://github.com/AvengeMedia/DankMaterialShell/raw/refs/heads/master/PLUGINS/plugin-schema.json",
    "id": "shotrec",
    "name": "Shot & Rec",
    "description": "GNOME-style unified screenshot and screen recorder with an on-screen mode picker",
    "version": "0.4.2",
    "author": "Yinx",
    "icon": "screenshot_region",
    "type": "composite",
    "capabilities": [
        "daemon",
        "dankbar-widget",
        "ipc",
        "clipboard"
    ],
    "components": {
        "daemon": "./ShotRecDaemon.qml",
        "widget": "./ShotRecWidget.qml"
    },
    "settings": "./ShotRecSettings.qml",
    "requires_dms": ">=1.6.0",
    "dependencies": [
        "wf-recorder",
        "wl-copy",
        "ffmpeg"
    ],
    "permissions": [
        "settings_read",
        "settings_write",
        "process"
    ]
}
